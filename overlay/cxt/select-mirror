#!/bin/sh
# Run after netcfg, immediately before the real choose-mirror postinst.
# Probe validation is HTTPS + exact archive metadata, not a replacement for
# Debian's archive-signature verification in net-retriever/apt.
set -u
umask 077
LC_ALL=C
export LC_ALL
. /usr/share/debconf/confmodule

state=/var/lib/cxt
mkdir -p "$state" || exit 1
chmod 700 "$state" || exit 1
rm -f "$state/mirror.complete" "$state/mirror.security.InRelease" || exit 1
: >"$state/mirror.evidence" || exit 1
log() {
    printf '%s\n' "$*" >>"$state/mirror.evidence" || exit 1
    logger -t cxt-mirror "$*" || true
}
fail() {
    log "ERROR: $*; mirror selection blocked"
    exit 1
}
[ "$#" -eq 1 ] || fail 'Expected exactly one region: auto, cn, or global'
requested=$1
case "$requested" in auto|cn|global) ;; *) fail 'Invalid region' ;; esac
for executable in curl awk gunzip sha256sum wc mktemp; do
    command -v "$executable" >/dev/null 2>&1 || fail "Missing installer dependency: $executable"
done
[ -s /etc/ssl/certs/ca-certificates.crt ] || fail 'Missing HTTPS CA trust bundle'
tmp=$(mktemp -d "$state/.mirror.XXXXXX") || fail 'Cannot create private probe directory'
trap 'rm -rf "$tmp"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
log "Requested region: $requested; UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"

# All URLs are constructed below from fixed services/hosts. CERNET may redirect
# to its member mirrors; each hop must remain HTTPS with normal CA/host checks.
# --disable must be first: never inherit a curlrc that changes trust or routing.
fetch() {
    curl --disable --fail --silent --show-error --location --max-redirs 5 \
        --proto '=https' --proto-redir '=https' --tlsv1.2 \
        --cacert /etc/ssl/certs/ca-certificates.crt \
        --connect-timeout 6 --max-time 20 \
        --retry 1 --retry-delay 1 --retry-max-time 25 \
        --max-filesize "$3" --output "$2" --write-out '%{url_effective}\n' \
        "$1" >"$tmp/effective" 2>"$tmp/curl.error"
}

# Check the clear-signed envelope and exact Debian codename/architecture. Extract
# only a SHA256 index entry, rejecting duplicate fields/entries and oversized
# files. This is deliberately a plausibility check: apt still verifies signatures
# using Debian's existing trusted keyring, without allow_unauthenticated options.
release_index() {
    awk -v codename="$2" -v index_path="$3" '
        NR == 1 { if ($0 != "-----BEGIN PGP SIGNED MESSAGE-----") exit 1; next }
        !body && !signature {
            if ($0 ~ /^Hash: (SHA256|SHA384|SHA512)(,|$)/) hash_header = 1
            if ($0 == "") body = 1
            next
        }
        $0 == "-----BEGIN PGP SIGNATURE-----" { signature++; body = 0; next }
        $0 == "-----END PGP SIGNATURE-----" { signature_end++; next }
        signature { next }
        body {
            if ($0 ~ /^Origin:/) { origin++; if ($0 != "Origin: Debian") bad = 1 }
            if ($0 ~ /^Codename:/) { names++; if ($0 != "Codename: " codename) bad = 1 }
            if ($0 ~ /^Architectures:/) {
                architectures++
                for (i = 2; i <= NF; i++) if ($i == "amd64") amd64 = 1
            }
            if ($0 ~ /^Components:/) {
                components++
                for (i = 2; i <= NF; i++)
                    if ($i == "main" || (codename == "trixie-security" && $i == "updates/main")) main = 1
            }
            if ($0 == "SHA256:") { sha_section = 1; next }
            if ($0 ~ /^[^ \t]/) sha_section = 0
            if (sha_section && $3 == index_path) {
                entries++
                if (NF != 3 || length($1) != 64 || $1 ~ /[^0-9a-f]/ ||
                    $2 !~ /^[0-9]+$/ || $2 + 0 < 1 || $2 + 0 > 8388608) bad = 1
                digest = $1; size = $2
            }
        }
        END {
            if (bad || !hash_header || signature != 1 || signature_end != 1 ||
                origin != 1 || names != 1 || architectures != 1 || !amd64 ||
                components != 1 || !main || entries != 1) exit 1
            print digest, size
        }
    ' "$1"
}

# Require a genuine amd64 installer-package paragraph, not an HTML success page.
# Security uses the same checks with ordinary binary package paragraphs instead.
decode_index() {
    case "$1" in
        udeb) gunzip -c "$tmp/Packages.gz" ;;
        deb) xzcat "$tmp/Packages.gz" ;;
    esac
}

package_index() {
    case "$1" in
        udeb) gunzip -t "$tmp/Packages.gz" 2>/dev/null || return 1 ;;
        deb) unxz -t "$tmp/Packages.gz" 2>/dev/null || return 1 ;;
    esac
    decode_index "$1" | awk -v kind="$1" '
        BEGIN { RS = ""; FS = "\n" }
        {
            package = architecture = filename = checksum = size = ""
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^Package: /) package = substr($i, 10)
                if ($i ~ /^Architecture: /) architecture = substr($i, 15)
                if ($i ~ /^Filename: /) filename = substr($i, 11)
                if ($i ~ /^SHA256: /) checksum = substr($i, 9)
                if ($i ~ /^Size: /) size = substr($i, 7)
            }
            if (architecture != "amd64" || length(checksum) != 64 ||
                checksum ~ /[^0-9a-f]/ || size !~ /^[0-9]+$/ || size + 0 < 1) next
            if (kind == "udeb" && package == "anna" &&
                filename ~ /^pool\/main\/a\/anna\/anna_[^\/]+_amd64\.udeb$/) valid = 1
            if (kind == "deb" && package ~ /^[a-z0-9][a-z0-9+.-]*$/ &&
                filename ~ /^pool\/(updates\/)?main\/.+_amd64\.deb$/) valid = 1
        }
        END { if (!valid) exit 1 }
    '
}

probe() {
    # The caller supplies only these three fixed hosts and these two paths.
    case "$1" in mirrors.cernet.edu.cn|mirrors.ustc.edu.cn|deb.debian.org) ;; *) return 1 ;; esac
    case "$2:$3:$4" in
        /debian:trixie:udeb) index=main/debian-installer/binary-amd64/Packages.gz ;;
        /debian-security:trixie-security:deb) index=main/binary-amd64/Packages.xz ;;
        *) return 1 ;;
    esac
    base="https://$1$2/dists/$3"
    log "Probing $base/InRelease and $index"
    if ! fetch "$base/InRelease" "$tmp/InRelease" 4194304; then
        log "Rejected $base: verified HTTPS InRelease retrieval failed"
        return 1
    fi
    # Record the actual HTTPS redirect destination without logging response bodies.
    effective=$(awk 'NR == 1 { gsub(/[^ -~]/, ""); print substr($0, 1, 512) }' "$tmp/effective")
    entry=$(release_index "$tmp/InRelease" "$3" "$index") || {
        log "Rejected $base: not exact Debian $3 amd64 metadata with a SHA256 index"
        return 1
    }
    digest=${entry%% *}
    size=${entry#* }
    if ! fetch "$base/$index" "$tmp/Packages.gz" "$size"; then
        log "Rejected $base: verified HTTPS package-index retrieval failed"
        return 1
    fi
    actual_size=$(wc -c <"$tmp/Packages.gz") || return 1
    if [ "$actual_size" -ne "$size" ] ||
        ! printf '%s  %s\n' "$digest" "$tmp/Packages.gz" | sha256sum -c - >/dev/null 2>&1 ||
        ! package_index "$4"; then
        log "Rejected $base: package-index size, SHA256, gzip, or package-format check failed"
        return 1
    fi
    log "Validated $base: HTTPS InRelease=$effective; $index SHA256=$digest bytes=$size; exact Debian $3 amd64 $4 metadata"
    return 0
}

country=unknown
case "$requested" in
    cn) candidates='mirrors.cernet.edu.cn mirrors.ustc.edu.cn' ;;
    global) candidates=deb.debian.org ;;
    auto)
        # No account, token, query IP, or other secret is sent. Discard the
        # service response (including the public IP) when the probe exits.
        if fetch https://api.country.is/ "$tmp/country.json" 4096; then
            country=$(awk '
                { text = text $0 }
                END {
                    gsub(/[ \t\r\n]/, "", text)
                    if (text !~ /^\{.*\}$/) exit 1
                    if (!match(text, /"country":"[A-Z][A-Z]"/)) exit 1
                    code = substr(text, RSTART + 11, 2)
                    rest = substr(text, RSTART + RLENGTH)
                    if (rest ~ /"country":/) exit 1
                    print code
                }
            ' "$tmp/country.json") || country=unknown
        fi
        case "$country" in
            CN)
                log 'HTTPS country service reported CN; selecting domestic candidates'
                candidates='mirrors.cernet.edu.cn mirrors.ustc.edu.cn' ;;
            unknown)
                log 'Country detection unavailable; no country inferred. Trying reachable CERNET, USTC, then Debian official'
                candidates='mirrors.cernet.edu.cn mirrors.ustc.edu.cn deb.debian.org' ;;
            *)
                log "HTTPS country service reported $country; selecting Debian official"
                candidates=deb.debian.org ;;
        esac ;;
esac

selected=
for candidate in $candidates; do
    if probe "$candidate" /debian trixie udeb; then
        selected=$candidate
        cp "$tmp/InRelease" "$state/mirror.InRelease" || fail 'Cannot preserve main archive metadata'
        break
    fi
done
[ -n "$selected" ] || fail 'No permitted mirror passed Debian trixie amd64 installer checks'
case "$selected" in deb.debian.org) region=global ;; *) region=cn ;; esac
security=security.debian.org
if probe "$selected" /debian-security trixie-security deb; then
    security=$selected
    cp "$tmp/InRelease" "$state/mirror.security.InRelease" || fail 'Cannot preserve security archive metadata'
    log "Security archive supported on selected host: https://$security/debian-security"
else
    log "Selected host lacks validated HTTPS trixie-security metadata; retaining official https://security.debian.org/debian-security (not inferred reachable)"
fi

# Stock apt-setup 91security hardcodes HTTP. Keep security updates over HTTPS
# through its standard local-repository generator instead; no custom keys or
# trusted=yes options are supplied, so Debian archive signatures stay mandatory.
# apt-mirror-setup may not be unpacked until original choose-mirror runs.
# Register missing string settings so debconf retains them until its templates
# arrive; no values from the disk configuration are executed as commands.
for key in apt-setup/local0/repository apt-setup/local0/comment apt-setup/local0/source apt-setup/local0/key apt-setup/local0/options; do
    if ! db_get "$key"; then
        db_register mirror/http/hostname "$key" || fail "Cannot register debconf $key"
    fi
done
for setting in \
    'mirror/country manual' \
    'mirror/protocol https' \
    "mirror/https/hostname $selected" \
    'mirror/https/directory /debian' \
    'mirror/suite trixie' \
    'mirror/codename trixie' \
    'mirror/udeb/suite trixie' \
    "apt-setup/security_host $security" \
    'apt-setup/services-select updates' \
    "apt-setup/local0/repository deb https://$security/debian-security trixie-security main non-free-firmware" \
    'apt-setup/local0/comment Debian security updates' \
    'apt-setup/local0/source false'; do
    key=${setting%% *}
    value=${setting#* }
    db_set "$key" "$value" || fail "Cannot set debconf $key"
done
db_set mirror/https/proxy '' || fail 'Cannot clear HTTPS mirror proxy'
db_set apt-setup/local0/key '' || fail 'Cannot retain Debian archive keyring for security updates'
db_set apt-setup/local0/options '' || fail 'Cannot retain authenticated security repository options'
printf '%s\n' "$requested" >"$state/mirror.requested" || fail 'Cannot record requested region'
printf '%s\n' "$region" >"$state/mirror.region" || fail 'Cannot record selected region'
printf '%s\n' "$country" >"$state/mirror.country" || fail 'Cannot record country hint'
printf '%s\n' "$selected" >"$state/mirror.host" || fail 'Cannot record mirror host'
printf '%s\n' /debian >"$state/mirror.directory" || fail 'Cannot record mirror directory'
printf '%s\n' "$security" >"$state/mirror.security-host" || fail 'Cannot record security host'
log "Selected region=$region main=https://$selected/debian security=https://$security/debian-security; Debian archive signature checks remain enabled"
printf '%s\n' 'Mirror metadata validated; debconf configured; archive signatures remain mandatory.' >"$state/mirror.complete" || fail 'Cannot record mirror completion'
exit 0
